{
  "name": "@99freelas/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "auth:99freelas": "tsx src/index.ts auth:99freelas",
    "session:check": "tsx src/index.ts session:check",
    "session:shutdown": "tsx src/index.ts session:shutdown",
    "source:recommended": "tsx src/index.ts source:recommended",
    "source:hunt": "tsx src/index.ts source:hunt",
    "source:smart": "tsx src/index.ts source:smart",
    "autopilot:loop": "tsx src/index.ts autopilot:loop",
    "proposal:prefill": "tsx src/index.ts proposal:prefill",
    "proposal:observe": "tsx src/index.ts proposal:observe",
    "proposal:generate": "tsx src/index.ts proposal:generate",
    "proposal:submit": "tsx src/index.ts proposal:submit",
    "proposal:submit-batch": "tsx src/index.ts proposal:submit-batch"
  },
  "dependencies": {
    "@99freelas/config": "workspace:*",
    "@99freelas/core": "workspace:*",
    "@99freelas/integrations": "workspace:*",

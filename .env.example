NODE_ENV=development

# Supabase
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="proposal-audit"

# API
API_PORT=3333
API_BASE_URL="http://localhost:3333"

# Dashboard
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
NEXT_PUBLIC_API_BASE_URL="http://localhost:3333"

# Redis / BullMQ
REDIS_URL="redis://localhost:6379"

# E-mail / IMAP
IMAP_ENABLED=true
IMAP_HOST="imap.gmail.com"
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=""
IMAP_PASSWORD=""
EMAIL_FROM_FILTER="99freelas"
EMAIL_SUBJECT_FILTER=""

# LLM
LLM_PROVIDER="local-template"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
LLM_TEMPERATURE=0.35
LLM_MAX_TOKENS=1200

# 99Freelas Browser Session
BROWSER_AUTOMATION_RUNTIME="node-playwright"
BROWSER_HEADLESS=false
BROWSER_SESSION_MODE="dedicated-profile"
BROWSER_STORAGE_STATE_PATH="./.auth/99freelas.storage-state.json"
BROWSER_USER_DATA_DIR="./.auth/99freelas.automation-profile"
BROWSER_CHROME_PROFILE_DIRECTORY="Default"
BROWSER_SCREENSHOT_DIR="./.audit/screenshots"
PYTHON_EXECUTABLE="python3"
PYTHON_BROWSER_NAME="chromium"
PYTHON_BROWSER_PROFILE_DIR="./.auth/99freelas.python-profile"
PYTHON_BROWSER_STORAGE_STATE_PATH="./.auth/99freelas.python-storage-state.json"

# Modo operacional
AUTOMATION_MODE="AUTOPILOT"
AUTOPILOT_MIN_SCORE=60
REVIEW_MIN_SCORE=60

# Limites
MAX_AUTOPILOT_SUBMISSIONS_PER_DAY=15
MAX_AUTOPILOT_SUBMISSIONS_PER_HOUR=4
MAX_FAILED_SUBMISSIONS_PER_DAY=10
MAX_PROJECTS_FETCHED_PER_HOUR=30
# Maximo de paginas da listagem publica /projects varridas por ciclo (default: 15 ~300 projetos).
# Aumente somente se quiser cobrir mais paginas por varredura.
MAX_HUNT_PAGES=15

# Preco
PRICE_DISCOUNT_FACTOR=0.50
MIN_PROPOSAL_AMOUNT_BRL=150
MIN_DAILY_RATE_BRL=120
DEFAULT_HOURLY_RATE_BRL=50
MIN_ACCEPTABLE_AVERAGE_BID_BRL=200

# Prazo
DEADLINE_REDUCTION_FACTOR=0.75
MIN_DEADLINE_DAYS=2
MAX_DEADLINE_DAYS=45

# Flags de seguranca
AUTO_SUBMIT_ONLY_WITH_CLEAR_SCOPE=false
AUTO_SUBMIT_ONLY_WITH_AVERAGE_BID=false
REJECT_EXTERNAL_CONTACT_REQUESTS=true
REJECT_LOW_BUDGET_PROJECTS=true
REJECT_UNCLEAR_SCOPE_WHEN_AUTOPILOT=false
SAVE_SCREENSHOT_BEFORE_SUBMIT=true
SAVE_SCREENSHOT_AFTER_SUBMIT=true
SAVE_HTML_SNAPSHOT=false
ENABLE_REAL_99FREELAS_SUBMISSION=false
MIN_REAL_SUBMISSION_DETAILS_LENGTH=140

# Envio real (somente quando quiser habilitar de forma consciente)
# Exemplo:
# AUTOMATION_MODE="AUTOPILOT"
# ENABLE_REAL_99FREELAS_SUBMISSION=true
# pnpm proposal:submit -- --proposal-id <id> --live --confirm-live-submit

# Notificacoes
NOTIFICATION_PROVIDER="console"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
